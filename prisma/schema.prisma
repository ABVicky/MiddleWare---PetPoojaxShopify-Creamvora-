datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SyncState {
  RECEIVED
  VALIDATING
  QUEUED
  PROCESSING
  SYNCED
  RETRY_PENDING
  NEEDS_MAPPING
  NEEDS_REVIEW
  FAILED
  CANCELLED
  REFUNDED
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum MappingStatus {
  MAPPED
  UNMAPPED
  IGNORED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  role         UserRole  @default(ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

model ConnectedStore {
  id                      String   @id @default(cuid())
  shopDomain              String   @unique
  shopName                String?
  accessToken             String
  webhookSecret           String?
  apiVersion              String   @default("2024-04")
  isActive                Boolean  @default(true)
  webhookOrdersCreateId   String?
  webhookOrdersUpdatedId  String?
  webhookOrdersCancelledId String?
  lastConnectedAt         DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  orders                  ShopifyOrder[]

  @@map("connected_stores")
}

model IntegrationCredential {
  id           String   @id @default(cuid())
  provider     String   @default("PETPOOJA")
  environment  String   @default("staging") // mock, staging, production
  appKey       String
  appSecret    String
  accessToken  String
  restId       String
  orderApiUrl  String   @default("https://47pfzh5sf2.execute-api.ap-southeast-1.amazonaws.com/V1/save_order")
  menuApiUrl   String   @default("https://qle1yy2ydc.execute-api.ap-southeast-1.amazonaws.com/V1/mapped_restaurant_menus")
  isActive     Boolean  @default(true)
  lastTestedAt DateTime?
  lastTestStatus String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("integration_credentials")
}

model WebhookEvent {
  id             String    @id @default(cuid())
  deliveryId     String    @unique // X-Shopify-Webhook-Id
  topic          String    // orders/create, orders/updated, etc.
  shopDomain     String
  orderId        String?
  rawPayload     String    @db.Text
  hmacSignature  String
  status         String    @default("PROCESSED") // PROCESSED, DUPLICATE, INVALID_SIGNATURE, FAILED
  errorMessage   String?
  processedAt    DateTime  @default(now())
  createdAt      DateTime  @default(now())

  @@index([shopDomain, topic])
  @@index([orderId])
  @@map("webhook_events")
}

model ShopifyOrder {
  id                String       @id @default(cuid())
  shopifyOrderId    String       @unique
  orderNumber       String
  shopDomain        String
  storeId           String?
  store             ConnectedStore? @relation(fields: [storeId], references: [id], onDelete: SetNull)
  currency          String       @default("INR")
  financialStatus   String       // paid, pending, partially_paid, refunded, voided
  fulfillmentStatus String?      // fulfilled, unfulfilled, partial
  subtotalPrice     Decimal      @db.Decimal(12, 2)
  totalDiscounts    Decimal      @default(0) @db.Decimal(12, 2)
  totalShipping     Decimal      @default(0) @db.Decimal(12, 2)
  totalTax          Decimal      @default(0) @db.Decimal(12, 2)
  totalPrice        Decimal      @db.Decimal(12, 2)
  paymentGateway    String?
  isCashOnDelivery  Boolean      @default(false)
  customerName      String?
  customerEmail     String?
  customerPhone     String?
  deliveryAddress   String?      @db.Text
  deliveryNotes     String?
  shopifyCreatedAt  DateTime
  syncStatus        SyncState    @default(RECEIVED)
  rawJson           String       @db.Text
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  items             ShopifyOrderItem[]
  petpoojaOrder     PetpoojaOrder?
  syncJobs          SyncJob[]

  @@index([shopDomain, syncStatus])
  @@index([shopifyCreatedAt])
  @@map("shopify_orders")
}

model ShopifyOrderItem {
  id                 String         @id @default(cuid())
  orderId            String
  order              ShopifyOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopifyLineItemId  String
  shopifyProductId   String?
  shopifyVariantId   String?
  sku                String?
  title              String
  variantTitle       String?
  quantity           Int
  unitPrice          Decimal        @db.Decimal(12, 2)
  discountAmount     Decimal        @default(0) @db.Decimal(12, 2)
  taxAmount          Decimal        @default(0) @db.Decimal(12, 2)
  totalPrice         Decimal        @db.Decimal(12, 2)
  petpoojaItemId     String?
  petpoojaVariationId String?
  mappingStatus      MappingStatus  @default(UNMAPPED)
  createdAt          DateTime       @default(now())

  @@index([shopifyVariantId])
  @@index([sku])
  @@map("shopify_order_items")
}

model ProductMapping {
  id                   String         @id @default(cuid())
  shopifyProductId     String?
  shopifyVariantId     String         @unique
  shopifySku           String?
  shopifyTitle         String
  shopifyVariantTitle  String?
  petpoojaItemId       String
  petpoojaItemName     String
  petpoojaVariationId  String?
  petpoojaVariationName String?
  petpoojaAddonDetails String?        @db.Text // JSON string of mapped add-ons
  status               MappingStatus  @default(MAPPED)
  lastValidatedAt      DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([shopifySku])
  @@index([petpoojaItemId])
  @@map("product_mappings")
}

model PetpoojaOrder {
  id                 String       @id @default(cuid())
  shopifyOrderId     String       @unique
  shopifyOrder       ShopifyOrder @relation(fields: [shopifyOrderId], references: [id], onDelete: Cascade)
  clientOrderId      String       @unique // e.g. Shopify Order Number passed to Petpooja
  petpoojaOrderId    String?      // Petpooja-generated order ID returned in save_order response
  restId             String
  orderStatus        String       @default("SUBMITTED") // SUBMITTED, ACCEPTED, REJECTED, FOOD_READY, DISPATCHED, CANCELLED
  requestPayload     String       @db.Text
  responsePayload    String?      @db.Text
  errorMessage       String?
  httpStatusCode     Int?
  billedAt           DateTime?
  syncedAt           DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([petpoojaOrderId])
  @@index([clientOrderId])
  @@map("petpooja_orders")
}

model SyncJob {
  id             String       @id @default(cuid())
  shopifyOrderId String
  shopifyOrder   ShopifyOrder @relation(fields: [shopifyOrderId], references: [id], onDelete: Cascade)
  jobType        String       @default("ORDER_SYNC") // ORDER_SYNC, STATUS_CHECK, CANCEL_SYNC
  state          SyncState    @default(QUEUED)
  priority       Int          @default(0)
  attempts       Int          @default(0)
  maxAttempts    Int          @default(5)
  lastError      String?      @db.Text
  nextRunAt      DateTime     @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  attemptsHistory SyncAttempt[]

  @@index([state, nextRunAt])
  @@index([shopifyOrderId])
  @@map("sync_jobs")
}

model SyncAttempt {
  id             String    @id @default(cuid())
  syncJobId      String
  syncJob        SyncJob   @relation(fields: [syncJobId], references: [id], onDelete: Cascade)
  attemptNumber  Int
  state          SyncState
  requestPayload String?   @db.Text
  responsePayload String?  @db.Text
  errorMessage   String?   @db.Text
  durationMs     Int?
  createdAt      DateTime  @default(now())

  @@map("sync_attempts")
}

model ReconciliationRun {
  id                  String   @id @default(cuid())
  runType             String   @default("SCHEDULED") // SCHEDULED, MANUAL
  status              String   @default("COMPLETED") // RUNNING, COMPLETED, FAILED
  checkedOrdersCount  Int      @default(0)
  matchedCount        Int      @default(0)
  mismatchedCount     Int      @default(0)
  fixedCount          Int      @default(0)
  summaryJson         String?  @db.Text
  startedAt           DateTime @default(now())
  completedAt         DateTime?

  @@map("reconciliation_runs")
}

model AuditLog {
  id            String   @id @default(cuid())
  correlationId String?
  action        String
  entityType    String
  entityId      String?
  actor         String   @default("SYSTEM")
  detailsJson   String?  @db.Text
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([correlationId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model IntegrationSettings {
  id                      String   @id @default("default")
  autoSyncTrigger         String   @default("payment_confirmed") // payment_confirmed, order_created
  requireExactTotalMatch  Boolean  @default(true)
  allowPartialMappingSync Boolean  @default(false)
  defaultOrderType        String   @default("Delivery") // Delivery, PickUp, DineIn
  maxRetries              Int      @default(5)
  enableMockMode          Boolean  @default(false)
  alertEmail              String?
  updatedAt               DateTime @updatedAt

  @@map("integration_settings")
}
