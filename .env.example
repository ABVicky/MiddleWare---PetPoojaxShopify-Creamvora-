# Database Connection (Neon / Supabase PostgreSQL)
# Use a pooled connection URL for serverless Vercel Functions
DATABASE_URL="postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# Direct URL used for Prisma CLI migrations
DIRECT_URL="postgresql://user:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Application Base URL (Vercel deployment domain or local dev)
APP_URL="https://petpooja-middleware.vercel.app"

# Vercel Cron & Internal API Secret (Protects /api/cron/* and internal triggers)
CRON_SECRET="generate_a_secure_random_hex_string_min_32_chars"

# Shopify Store & API Configuration
SHOPIFY_SHOP_DOMAIN="your-store.myshopify.com"
SHOPIFY_CLIENT_ID="your_shopify_client_id"
SHOPIFY_CLIENT_SECRET="your_shopify_client_secret"
SHOPIFY_WEBHOOK_SECRET="your_shopify_webhook_signing_secret"
SHOPIFY_ACCESS_TOKEN="shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
SHOPIFY_API_VERSION="2024-04"

# Petpooja POS Integration Configuration
# Mode: "mock" (offline test mode), "staging" (Petpooja sandbox), or "production"
PETPOOJA_ENV="staging"
PETPOOJA_APP_KEY="rps3igv8ucfhydx01ao6k9ebnz75tqw4"
PETPOOJA_APP_SECRET="71b70724b84d8d8ea06fe9cc0da105b07c412228"
PETPOOJA_ACCESS_TOKEN="7337c1365cf2e61fe5f2b9f8d445db00dc6c39a1"
PETPOOJA_REST_ID="SAMPLE_REST_101"

# Petpooja AWS Gateway Endpoints
PETPOOJA_ORDER_API_URL="https://47pfzh5sf2.execute-api.ap-southeast-1.amazonaws.com/V1/save_order"
PETPOOJA_MENU_API_URL="https://qle1yy2ydc.execute-api.ap-southeast-1.amazonaws.com/V1/mapped_restaurant_menus"
PETPOOJA_STORE_API_URL="https://qle1yy2ydc.execute-api.ap-southeast-1.amazonaws.com/V1/update_store_status"
PETPOOJA_STOCK_API_URL="https://qle1yy2ydc.execute-api.ap-southeast-1.amazonaws.com/V1/update_item_stock"

# Integration Policy Settings
# AUTO_SYNC_TRIGGER: "payment_confirmed" (sync only paid/authorized) or "order_created" (sync immediately on creation)
AUTO_SYNC_TRIGGER="payment_confirmed"
# REQUIRE_EXACT_TOTAL_MATCH: true | false
REQUIRE_EXACT_TOTAL_MATCH="true"
# DEFAULT_ORDER_TYPE: "Delivery" | "PickUp" | "DineIn"
DEFAULT_ORDER_TYPE="Delivery"

# Security & Dashboard Access
ADMIN_SESSION_SECRET="generate_secure_random_session_secret"
